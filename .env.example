# ─── CrawlCat ──────────────────────────────────────────────
# Copy to .env. Everything is optional: with no keys the cat runs in paper mode
# and the crew uses its offline brain.

# Solana RPC used by the paws (a private endpoint avoids rate limits)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Live mode. Leave at 0 until you have read docs/SAFETY.md.
LIVE=0
PUMPPORTAL_API_KEY=            # Lightning API key (its wallet does the live trading)
PINATA_JWT=                    # hosts launch images + metadata on IPFS

# Paws (one fail = the coin gets wrapped)
SETTLE_SECONDS=8
MAX_TOP10_PCT=30
MAX_BUNDLE_PCT=20
MAX_WASH_PCT=50
MAX_DEV_SOLD_PCT=20

# Trading
BUY_SOL=0.1
SLIPPAGE_PCT=15
PRIORITY_FEE_SOL=0.0005
TAKE_PROFIT_X=2
TAKE_PROFIT_FRACTION=0.5
TRAILING_STOP_PCT=25
STOP_LOSS_PCT=35
MAX_HOLD_MINUTES=15
MAX_OPEN_POSITIONS=5
PAPER_START_SOL=10

# Launching
DEV_BUY_SOL=0.5

# The crew. Each seat: CREW_<ROLE>_{API_KEY,BASE_URL,MODEL,FORMAT,NAME}
# FORMAT is "openai" (default, any OpenAI-compatible API) or "anthropic".
# CREW_SCOUT_API_KEY=xai-...
# CREW_SCOUT_BASE_URL=https://api.x.ai/v1
# CREW_SCOUT_MODEL=grok-4
# CREW_WRITER_API_KEY=sk-or-...
# CREW_WRITER_BASE_URL=https://openrouter.ai/api/v1
# CREW_WRITER_MODEL=<your-model>
# CREW_RESEARCHER_API_KEY=...
# CREW_TIMER_API_KEY=...

# Memory: an Obsidian vault folder (notes land in <vault>/CrawlCat/...)
OBSIDIAN_VAULT=
